# Copy this file to .env and adjust the values for your machine.
# Nothing in this file is a secret. .env is ignored by git; this example is tracked.
#
# The commands read the defaults below; export the values or pass them to the
# command line as shown in docs/RUNBOOK.md.
PYTHONUTF8=1
DISPUTE_PORT=8765
DISPUTE_DATA=data/dev
DISPUTE_STATE=.state/mock.sqlite

# ---------------------------------------------------------------------------
# AWS pilot. Leave these blank until you deploy; the local commands ignore them.
# deploy/poc/terraform/phases.sh loads .env automatically. Two ways to supply
# credentials, either is enough: fill in the two lines below, or run
# "aws configure" once and leave them blank (phases.sh then uses the profile).
# Never commit a filled-in .env: git ignores it, and the env-files job in
# .github/workflows/checks.yml fails the build if one is ever tracked.
# ---------------------------------------------------------------------------
# Scope these to a sandbox account. If the account is not yours to spend in,
# stop before the terraform apply.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials: SSO, AssumeRole, or a sandbox session token.
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Optional overrides, same defaults as variables.tf. Uncomment to use.
# CIDRs allowed to reach the load balancer. Unset means the stack allows only
# this workstation's public IP as a /32, which breaks a demo on another network.
# TF_VAR_allowed_cidrs='["0.0.0.0/0"]'
# TF_VAR_owner="Coforge FDE Pod"
# TF_VAR_name="ccd-poc"
# TF_VAR_cpu_architecture="ARM64"
# TF_VAR_create_vpc=true

# ---------------------------------------------------------------------------
# Hybrid model. Optional. The drafting commands try the approved default pair
# (azure_openai/gpt-6-luna) when MODEL_PROVIDER is unset, and fall back to the
# rules when it cannot be set up. tools/run_model.sh reads this file; the
# Python commands read the process environment, so source it or use the
# wrapper. Keep the key here or in the environment, never in models.toml.
# ---------------------------------------------------------------------------
# MODEL_PROVIDER=azure_openai
# MODEL_ID=gpt-6-luna
# Paste either the resource URL or the operation URL the portal shows; the
# client strips /openai/v1/responses (or /openai/v1) before it builds the base.
# AZURE_OPENAI_ENDPOINT=https://RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=
# To replay a recording instead, set these two lines and leave the key blank:
# MODEL_PROVIDER=replay
# MODEL_REPLAY=evals/recordings/gpt-6-luna.jsonl
