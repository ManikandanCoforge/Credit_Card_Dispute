root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4

# YAML and JSON are two-space files here, in the workflow and in the data.
[*.{yml,yaml,json}]
indent_size = 2

# Markdown keeps a trailing double space when it means a hard line break.
[*.md]
trim_trailing_whitespace = false

# A Makefile needs a real tab, not spaces.
[Makefile]
indent_style = tab
